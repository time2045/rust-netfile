{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NB 文件管理器",
  "version": "1.1.0",
  "identifier": "local.nb-file-manager.desktop",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NB 文件管理器",
        "width": 1060,
        "height": 740,
        "minWidth": 880,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
